# AI Agent Workflow Builder

## Environment Variables
# Copy this file to .env and fill in the values

# === Nhost Cloud (Production) ===
NEXT_PUBLIC_NHOST_SUBDOMAIN=your-nhost-subdomain
NEXT_PUBLIC_NHOST_REGION=eu-central-1

# === Local Development ===
POSTGRES_PASSWORD=postgres_secret_change_me
HASURA_GRAPHQL_ADMIN_SECRET=hasura_admin_secret_change_me
NHOST_JWT_SECRET='{"type":"HS256","key":"a_very_long_secret_key_at_least_32_characters_long_for_hs256!!"}'
NHOST_ADMIN_SECRET=hasura_admin_secret_change_me
NHOST_WEBHOOK_SECRET=nhost_webhook_secret_change_me

# === Gemini API ===
GEMINI_API_KEY=your_gemini_api_key_here

# === URLs (local dev defaults) ===
HASURA_GRAPHQL_URL=http://graphql-engine:8080/v1/graphql
HASURA_GRAPHQL_ENDPOINT=http://graphql-engine:8080
NHOST_AUTH_URL=http://auth:4000
NHOST_FUNCTIONS_URL=http://functions:3000
DATABASE_URL=postgres://postgres:postgres_secret_change_me@postgres:5432/postgres
